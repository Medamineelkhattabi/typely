{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Settings window: settings, secrets (write-only), provider requests, Ollama detection.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-settings-get",
    "allow-settings-save",
    "allow-secret-set",
    "allow-secret-delete",
    "allow-secret-status",
    "allow-provider-request",
    "allow-provider-stream",
    "allow-provider-cancel",
    "allow-ollama-detect"
  ]
}
