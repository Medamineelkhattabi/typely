{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Typely",
  "version": "0.1.0",
  "identifier": "app.typely.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Typely",
        "url": "index.html",
        "width": 920,
        "height": 660,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "visible": false
      },
      {
        "label": "panel",
        "title": "Typely",
        "url": "index.html",
        "width": 460,
        "height": 420,
        "visible": false,
        "focus": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main-window", "panel-window"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Mohamed Amine EL Khattabi",
    "shortDescription": "Local-first writing assistant",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
