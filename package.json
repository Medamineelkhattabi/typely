{
  "name": "typely",
  "version": "0.1.0",
  "private": true,
  "description": "TYPELY — AI-powered universal writing assistant",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "typely": "node scripts/typely-cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
